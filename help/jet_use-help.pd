#N canvas 100 100 700 870 10;
#X obj 40 40 jet_win;
#X msg 40 80 create;
#X msg 130 80 destroy;
#X obj 40 130 jet_head 0;
#X obj 40 165 jet_perlin 256 256;
#X obj 40 200 jet_share noise;
#X text 210 165 <- a texture source;
#X text 210 200 <- publishes it under the name "noise";
#X obj 40 260 jet_head 1;
#X obj 40 295 t b b;
#X obj 40 335 jet_separator;
#X obj 40 365 jet_translateXYZ -2.5 0 0;
#X obj 40 395 jet_use noise;
#X obj 40 425 jet_rectangle 2 2;
#X obj 300 335 jet_separator;
#X obj 300 365 jet_translateXYZ 2.5 0 0;
#X obj 300 395 jet_rotateXYZ 20 30 0;
#X obj 300 425 jet_use noise;
#X obj 300 455 jet_cube 2.5;
#X text 210 260 <- runs after priority 0 \, so "noise" is already there;
#X text 40 500 [jet_use name] makes the texture published as "name" (by [jet_share name]) the chain's current texture and forwards the bang. Everything after it - jet_rectangle \, jet_cube \, jet_feedback \, jet_shader - sees it as if the producer sat right above. Right inlet or "name <symbol>" changes the name \, for instance to switch between several textures.;
#X text 40 610 Any number of consumers may use the same name \, in any chain. If the name has not been published (yet) \, the current texture is left as it was and the bang is forwarded \; the first frames are allowed to miss \, after about two seconds a message appears in the Pd window. Wrap a branch in [jet_separator] so the texture bound by jet_use doesn't leak into its siblings.;
#X text 40 720 Tip: names are per jet_win. Two windows can use the same name for different textures without interfering.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 8 0 9 0;
#X connect 9 1 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 9 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
