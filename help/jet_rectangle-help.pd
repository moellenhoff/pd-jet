#N canvas 100 100 760 800 10;
#X obj 40 40 jet_win;
#X msg 40 80 create;
#X msg 130 80 destroy;
#X obj 40 130 jet_head 0;
#X obj 40 165 jet_color 0.85 0.47 0.34;
#X obj 40 200 jet_translateXYZ 0 0 0;
#X obj 40 245 jet_rectangle 2 1.5;
#X text 210 130 <- the render tick bangs the chain every frame;
#X text 210 165 <- colour comes from the chain: jet_color;
#X text 210 200 <- position comes from the chain: jet_translateXYZ;
#X text 210 245 <- [jet_rectangle halfwidth halfheight];
#X text 40 290 jet_rectangle inlets (left to right): chain | half width | half height;
#X floatatom 40 320 5 0 12 0 - - -;
#X floatatom 130 320 5 0 12 0 - - -;
#X text 40 345 half width;
#X text 130 345 half height;
#X text 220 320 <- a float only stores the value\; drawing happens on the next bang from the chain;
#X msg 40 385 size 5.33 4;
#X msg 135 385 size 2 1.5;
#X msg 225 385 size 1;
#X msg 300 385 size 0.5 3;
#X text 40 415 size w h sets both at once (a single value makes a square)\; so does a list "w h" into the left inlet;
#X text 400 290 move it - jet_translateXYZ inlets 1 2 3 = x y z;
#X floatatom 400 320 5 -8 8 0 - - -;
#X floatatom 480 320 5 -8 8 0 - - -;
#X text 400 345 x;
#X text 480 345 y;
#X text 40 460 Sizes are HALF sizes \, exactly like Gem's [rectangle]: the shape reaches halfwidth to the left AND to the right of its centre \, so [jet_rectangle 2 1.5] is 4 units wide and 3 units tall. It is centred on the origin of the chain - there is no x/y argument any more\; use jet_translateXYZ (and jet_rotateXYZ / jet_scaleXYZ) in front of it \, wrapped in a jet_separator if other shapes follow.;
#X text 40 560 Gem units: the window is always 8 units tall (y = -4..+4) and 8 * aspect wide. On an 800x600 window x runs from -5.33 to +5.33 \, so [jet_rectangle 5.33 4] fills the whole picture - the same numbers as in Gem. Resize the window: the shape keeps its proportions.;
#X text 40 630 Colour: there is no colour argument. The rectangle uses the chain's current colour (white if no jet_color came before it). If jet_texture or a picture/video source bound a texture earlier in the chain \, the rectangle draws that texture instead \, multiplied by the chain colour (a tint). The bang is forwarded out of the outlet \, so more objects can follow it.;
#X floatatom 560 320 5 -8 8 0 - - -;
#X text 560 345 z;
#X text 40 690 Shapes are real 3D geometry \, drawn through the window's camera \, so z works: a negative z pushes the rectangle back (smaller \, by perspective) \, and jet_rotateXYZ can tip it around X and Y. Depth testing is on \, as in Gem \, so shapes hide what is behind them. Two shapes in the exact same plane can then flicker against each other - put [jet_depth 0] in front of them to layer by drawing order instead.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 17 0 6 0;
#X connect 18 0 6 0;
#X connect 19 0 6 0;
#X connect 20 0 6 0;
#X connect 12 0 6 1;
#X connect 13 0 6 2;
#X connect 23 0 5 1;
#X connect 24 0 5 2;
#X connect 30 0 5 3;
