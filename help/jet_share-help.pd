#N canvas 100 100 700 870 10;
#X obj 40 40 jet_win;
#X msg 40 80 create;
#X msg 130 80 destroy;
#X obj 40 130 jet_head 0;
#X obj 40 165 jet_perlin 256 256;
#X obj 40 200 jet_share noise;
#X text 210 165 <- a texture source;
#X text 210 200 <- publishes it under the name "noise";
#X obj 40 260 jet_head 1;
#X obj 40 295 t b b;
#X obj 40 335 jet_separator;
#X obj 40 365 jet_translateXYZ -2.5 0 0;
#X obj 40 395 jet_use noise;
#X obj 40 425 jet_rectangle 2 2;
#X obj 300 335 jet_separator;
#X obj 300 365 jet_translateXYZ 2.5 0 0;
#X obj 300 395 jet_rotateXYZ 20 30 0;
#X obj 300 425 jet_use noise;
#X obj 300 455 jet_cube 2.5;
#X text 210 260 <- runs after priority 0 \, so "noise" is already there;
#X text 40 500 [jet_share name] publishes the chain's current texture under a name. The chain carries on unchanged (the texture stays bound) \, so you can still draw it right there. Right inlet or "name <symbol>" changes the name. A texture source like jet_perlin \, jet_video \, jet_movie \, jet_texture or jet_feedback ahead of it provides the texture.;
#X text 40 610 Why: the plain "current texture" only flows down ONE chain \, and each chain starts empty. A name lets any other chain use the texture - in this patch the square and the cube are in a different chain from the noise \, and both use the same texture. Names belong to the window and last until the same name is published again.;
#X text 40 720 Order: jet_head priorities decide who runs first (lower number first). A consumer that runs before the producer sees the previous frame's texture - one frame of latency \, which also makes loops possible (feed a rendered result back in next frame).;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 8 0 9 0;
#X connect 9 1 10 0;
#X connect 10 0 11 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
#X connect 9 0 14 0;
#X connect 14 0 15 0;
#X connect 15 0 16 0;
#X connect 16 0 17 0;
#X connect 17 0 18 0;
