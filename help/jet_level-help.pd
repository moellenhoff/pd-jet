#N canvas 100 100 780 670 10;
#X obj 40 40 jet_win;
#X msg 40 80 create;
#X msg 130 80 destroy;
#X obj 40 130 jet_head 0;
#X obj 40 165 jet_shader plasma.metal;
#X obj 40 200 jet_level;
#X obj 40 235 jet_rectangle 3.2 2.4;
#X floatatom 40 290 5 -1 1 0 - - -;
#X text 40 315 brightness;
#X floatatom 145 290 5 0 3 0 - - -;
#X text 145 315 contrast;
#X floatatom 250 290 5 0.2 3 0 - - -;
#X text 250 315 gamma;
#X text 40 390 [jet_level] changes brightness \, contrast and gamma of the picture. brightness is added to every channel (0 = unchanged) \, contrast 1 = unchanged / 0 = flat grey / above 1 = harder \, gamma 1 = unchanged / above 1 brightens the mid-tones.;
#X text 40 510 Creation arguments fill the parameters in order: [jet_level 0.1 1.3 1]. Like every jet effect it takes the chain's current texture and hands the result on as the new current texture \; the output has the size of the input (send "resolution w h" to change it). The parameter inlets only store - the next bang from the chain uses them - and the same values can be sent to the left inlet by name \, "info" lists them. After the chain below it has run \, the block puts the texture back the way it found it \, so it acts like a separator for textures.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 7 0 5 1;
#X connect 9 0 5 2;
#X connect 11 0 5 3;
