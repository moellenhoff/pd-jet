#N canvas 100 100 560 540 10;
#X obj 40 40 jet_win;
#X msg 40 100 create;
#X msg 130 100 destroy;
#X obj 40 150 jet_head 0;
#X obj 40 180 jet_movie ./anim-1.mov;
#X obj 40 210 jet_texture;
#X obj 40 240 jet_rectangle 3.2 3.2;
#X msg 250 150 open ./anim-1.mov;
#X msg 250 190 loop 0;
#X msg 320 190 loop 1;
#X msg 250 230 play 0;
#X msg 320 230 play 1;
#X floatatom 250 270 5 0 0 0 frame - -;
#X msg 250 310 fps 12;
#X msg 340 310 fps 0;
#X text 40 340 jet_movie decodes one video frame per bang \, exactly
like jet_image/jet_perlin - here it's chained straight under
jet_head. it now plays at the clip's own native frame rate by
default (read from the file itself) \, regardless of how often the
chain bangs it - so a 60fps jet_win driving a 24fps clip still
looks correct \, not sped up. fps <n> overrides that with a custom
rate \; fps 0 (or any value <= 0) goes back to native. loop 1 (default)
restarts the reader at the end since AVAssetReader can't seek backward
on its own \; loop 0 stops there. play 0/play 1 pause/resume without
touching the picture (the last decoded frame just stays frozen on
screen). a plain number seeks directly to that frame index - handy
while stopped to step through the clip \, and playback continues
forward from wherever you sought to. reaching the end with loop
off now only prints one error and then goes quiet \, auto-stopping
instead of spamming the console. audio isn't handled by this object
- that's a separate \, real Pd signal object for a future session. \; frame numbers work while paused too (play 0) - you can scrub through the clip with a slider or a counter. A number beyond the last frame wraps around while loop is on and stops at the last frame while loop is off.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 7 0 4 0;
#X connect 8 0 4 0;
#X connect 9 0 4 0;
#X connect 10 0 4 0;
#X connect 11 0 4 0;
#X connect 12 0 4 0;
#X connect 13 0 4 0;
#X connect 14 0 4 0;
