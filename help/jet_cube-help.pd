#N canvas 100 100 760 680 10;
#X obj 40 40 jet_win;
#X msg 40 100 create;
#X msg 130 100 destroy;
#X obj 40 150 jet_head 0;
#X obj 40 180 t b b;
#X obj 40 210 f 0;
#X obj 150 210 + 2;
#X msg 40 240 set 0 \$1 0;
#X obj 40 270 jet_rotateXYZ 0 0 0;
#X obj 40 300 jet_translateXYZ 0 0 0;
#X obj 40 330 jet_scaleXYZ 1 1 1;
#X obj 40 390 jet_cube 2;
#X msg 300 150 camera 0 0 4;
#X msg 420 150 camera 4 2 8;
#X msg 300 190 fov 90;
#X msg 420 190 fov 40;
#X msg 300 230 light 1 1 0.3;
#X msg 420 230 light -1 0.5 1;
#X msg 550 270 set 30 30 30;
#X msg 660 270 set 0 0 0;
#X msg 550 300 set 0.8 0 0;
#X msg 660 300 set 0 0 0;
#X msg 550 330 set 1.6 1.6 1.6;
#X msg 660 330 set 1 1 1;
#X text 300 270 rotateXYZ (tilt/reset);
#X text 300 300 translateXYZ (shift right/reset);
#X text 300 330 scaleXYZ (bigger/reset);
#X text 40 430 jet_rotateXYZ / jet_translateXYZ / jet_scaleXYZ are like Gem's own: one object each \, X/Y/Z all at once. The left inlet takes the chain (bang) and the "set x y z" message \, the three inlets after it are X \, Y and Z - they only store \, and the next bang applies them. Each one multiplies onto the chain's model transform \, which jet_win resets to identity before every chain \, so nothing leaks from one chain into the next. The counter here (f / + 2 / set) drives the Y rotation straight off the render tick - no metro needed - using the usual "set the value \, THEN bang" idiom (the [t b b] fires its right outlet first). Try the transform / camera / fov / light messages while it spins. jet_win owns the camera (position / lookat / fov) and the light \, computed once per frame. The colour comes from jet_color \; a cube is lit by the window light \, flat shapes like jet_rectangle are not.;
#X obj 40 360 jet_color 0.8 0.5 0.3;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 1 5 0;
#X connect 5 0 6 0;
#X connect 6 0 5 1;
#X connect 5 0 7 0;
#X connect 7 0 8 0;
#X connect 4 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 12 0 0 0;
#X connect 13 0 0 0;
#X connect 14 0 0 0;
#X connect 15 0 0 0;
#X connect 16 0 0 0;
#X connect 17 0 0 0;
#X connect 18 0 8 0;
#X connect 19 0 8 0;
#X connect 20 0 9 0;
#X connect 21 0 9 0;
#X connect 22 0 10 0;
#X connect 23 0 10 0;
#X connect 10 0 28 0;
#X connect 28 0 11 0;
