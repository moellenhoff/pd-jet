#N canvas 100 100 780 820 10;
#X obj 40 40 jet_win;
#X msg 40 80 create;
#X msg 130 80 destroy;
#X obj 380 130 jet_head 0;
#X obj 380 165 jet_perlin 256 256;
#X obj 380 200 jet_share noise;
#X text 540 165 <- a second texture \, published as "noise";
#X obj 40 130 jet_head 1;
#X obj 40 165 jet_shader plasma.metal;
#X obj 40 200 jet_mix noise 0.5 0;
#X obj 40 235 jet_rectangle 3.2 2.4;
#X floatatom 40 290 5 0 1 0 - - -;
#X text 40 315 amount;
#X floatatom 145 290 5 0 6 0 - - -;
#X text 145 315 mode 0-6;
#X msg 260 290 symbol noise;
#X text 260 315 <- the name of texture b (right inlet);
#X text 40 360 [jet_mix] blends the chain's texture (a) with a second texture (b). b is a named texture published somewhere else with [jet_share name] - here a jet_perlin in the other chain. Give the name as the creation argument ([jet_mix noise 0.5 0]) or to the second inlet. amount 0 = only a \, 1 = only b. mode: 0 mix \, 1 add \, 2 multiply \, 3 screen \, 4 difference \, 5 max \, 6 min (in the add/multiply/... modes amount says how strongly b is applied).;
#X text 40 500 Order matters: the chain that publishes the texture must run first (jet_head 0 before jet_head 1) \, otherwise the mix sees the previous frame's version of b - harmless here \, but useful to know. A missing name shows black as texture b. Creation arguments: symbols name the extra inputs \, numbers fill amount and mode in order. Output size = size of a.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 7 0 8 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 11 0 9 2;
#X connect 13 0 9 3;
#X connect 15 0 9 1;
