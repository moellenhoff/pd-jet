#N canvas 100 100 740 640 10;
#X obj 40 40 jet_win;
#X msg 40 80 create;
#X msg 130 80 destroy;
#X obj 40 130 jet_head 0;
#X obj 40 170 jet_color 1 0.3 0.3;
#X obj 40 210 jet_rectangle 1.5 1.5;
#X obj 40 250 jet_translateXYZ 3.5 0 0;
#X obj 40 290 jet_color 0.3 0.6 1;
#X obj 40 330 jet_triangle 1.5;
#X text 210 170 <- red from here on;
#X text 210 210 <- drawn red;
#X text 210 250 <- the chain continues through the shape;
#X text 210 290 <- blue from here on;
#X text 210 330 <- drawn blue and moved right;
#X text 380 125 red;
#X text 430 125 green;
#X text 490 125 blue;
#X floatatom 380 145 5 0 1 0 - - -;
#X floatatom 430 145 5 0 1 0 - - -;
#X floatatom 490 145 5 0 1 0 - - -;
#X msg 380 185 set 0.2 0.9 0.4;
#X msg 380 215 set 1 0.3 0.3;
#X text 380 245 <- "set r g b" (or a plain list) stores all three at once;
#X text 40 380 [jet_color r g b] is Gem's [color] for jet: it sets the chain's current colour (0..1 \, default 1 1 1) and then forwards the bang. Every shape after it is drawn in that colour \; a shape that has a texture multiplies the texture by it instead (tint). Inlets \, Gem-style: the left one takes the chain (bang) \, the three after it are red \, green and blue. They only store - the chain's next bang applies them (the render tick bangs it every frame).;
#X text 40 490 The colour belongs to the chain and starts as white in every chain and every frame \, so it never leaks into other chains. Inside one chain it stays set until the next jet_color - wrap a branch in [jet_separator] to keep its colour away from its siblings.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 4 0;
#X connect 4 0 5 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 7 0 8 0;
#X connect 20 0 4 0;
#X connect 21 0 4 0;
#X connect 17 0 4 1;
#X connect 18 0 4 2;
#X connect 19 0 4 3;
