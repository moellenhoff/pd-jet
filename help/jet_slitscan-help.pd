#N canvas 100 100 640 540 10;
#X obj 40 40 jet_win;
#X msg 40 100 create;
#X msg 130 100 destroy;
#X msg 250 100 start;
#X msg 340 100 stop;
#X obj 40 150 jet_head 1;
#X obj 40 180 jet_video;
#X obj 300 150 jet_head 0;
#X obj 300 180 jet_perlin 256 256;
#X obj 40 220 jet_slitscan 30;
#X obj 40 250 jet_rectangle 4.2 3.2;
#X msg 250 220 delay 10;
#X msg 340 220 delay 60;
#X msg 250 260 freeze 1;
#X msg 340 260 freeze 0;
#X text 40 300 jet_slitscan: per-PIXEL delay \, picked by the red
channel of a second "delay map" texture (0=now \, 255=max delay)
- here jet_perlin \, for an organic animated result \; try any gradient/ramp
image instead for a classic scanline slit-scan look. the two jet_head
branches run in priority order (0 before 1) \, so the delay-map chain
finishes and lands in jet_slitscan's RIGHT inlet before the main
video chain bangs its LEFT inlet each frame - same idea as Gem's
gem_right convention for dual-image pix_* objects\, just done with
two ordinary chains instead of a special inlet type. same texture2d_array
history ring buffer as jet_slitscan_line \, just indexed per-pixel
instead of per-row.;
#X connect 1 0 0 0;
#X connect 2 0 0 0;
#X connect 3 0 6 0;
#X connect 4 0 6 0;
#X connect 5 0 6 0;
#X connect 6 0 9 0;
#X connect 7 0 8 0;
#X connect 8 0 9 1;
#X connect 9 0 10 0;
#X connect 11 0 9 0;
#X connect 12 0 9 0;
#X connect 13 0 9 0;
#X connect 14 0 9 0;
